{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    // Library code runs in browsers, so typecheck it without Node or Vite's client types
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/tests", "src/stories", "**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"]
}

