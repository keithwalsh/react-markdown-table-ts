{
  "name": "react-markdown-table-ts",
  "version": "1.6.0",
  "description": "A React component that converts structured data into formatted Markdown table syntax and displays it in a styled code block with optional line numbers.",
  "keywords": [
    "markdown",
    "md",
    "table",
    "tables",
    "react",
    "generate",
    "generator",
    "convert",
    "converter"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithwalsh/react-markdown-table-ts.git"
  },
  "homepage": "https://github.com/keithwalsh/react-markdown-table-ts#readme",
  "bugs": {
    "url": "https://github.com/keithwalsh/react-markdown-table-ts/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/emit-cjs-types.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:bundle": "node scripts/test-bundle.mjs",
    "check:package": "publint && attw --pack .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.10",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7"
  }
}
